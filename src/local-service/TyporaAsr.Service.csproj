<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Platform selection (see docs/macos.md):
    - Windows build (default on Windows, or any non-osx RID): net10.0-windows + NAudio (WASAPI) + DPAPI.
    - macOS build (building on a Mac, or -r osx-arm64 / osx-x64, or -p:TyporaAsrPlatform=mac):
      net10.0 + NAudio.Core (resampler only) + Core Audio capture + Keychain.
  -->
  <PropertyGroup>
    <TyporaAsrPlatform Condition="'$(TyporaAsrPlatform)'=='' and $(RuntimeIdentifier.StartsWith('osx'))">mac</TyporaAsrPlatform>
    <TyporaAsrPlatform Condition="'$(TyporaAsrPlatform)'=='' and '$(RuntimeIdentifier)'=='' and $([MSBuild]::IsOSPlatform('OSX'))">mac</TyporaAsrPlatform>
    <TyporaAsrPlatform Condition="'$(TyporaAsrPlatform)'==''">windows</TyporaAsrPlatform>
    <TargetFramework Condition="'$(TyporaAsrPlatform)'=='mac'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TyporaAsrPlatform)'!='mac'">net10.0-windows</TargetFramework>
    <DefineConstants Condition="'$(TyporaAsrPlatform)'=='mac'">$(DefineConstants);TYPORA_MAC</DefineConstants>
    <DefineConstants Condition="'$(TyporaAsrPlatform)'!='mac'">$(DefineConstants);TYPORA_WINDOWS</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TyporaAsrPlatform)'!='mac'">
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Remove="Platform/Mac/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TyporaAsrPlatform)'=='mac'">
    <!-- Cross-platform part of NAudio: WaveFormat, BufferedWaveProvider, WDL resampler, WaveFileReader. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>
</Project>
